<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves this phone by backup or device transfer.

    allowBackup="false" stops cloud backup, but on Android 12+ a device-to-device
    transfer still copies app data unless it is excluded here. That would move
    the identity file — encrypted under a Keystore key that does not travel —
    to a phone that cannot decrypt it, and move private conversations along
    with it. Moving an identity is what the explicit, person-initiated backup
    in Settings is for.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
