<?xml version="1.0" encoding="utf-8"?>
<!-- The first item in every thread. What makes this chat different from
     every other chat app, said once, quietly, where it is true. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="@string/chat_banner"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/tc_text_dim"
        app:drawableStartCompat="@drawable/ic_lock"
        app:drawableTint="@color/tc_signal" />
</FrameLayout>
