<?xml version="1.0" encoding="utf-8"?>
<!-- Three tabs to swipe between: Chats (a ListView), Peers (a GridView) and
     My node. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tc_bg"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/tc_primary"
            app:tabIndicatorFullWidth="false"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/tc_text"
            app:tabTextAppearance="@style/TextAppearance.TorChat.Tab"
            app:tabTextColor="@color/tc_text_faint" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/tc_outline_soft" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/add_friend"
        app:icon="@drawable/ic_person_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
