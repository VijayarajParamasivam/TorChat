    <string name="app_name">TorChat</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Become a node</string>
    <string name="onboarding_body">TorChat has no servers and no accounts. This phone makes its own keys and joins the Tor network as a node of its own. Friends reach you at an onion address that says nothing about where you are.</string>
    <string name="onboarding_point_keys">Your keys are made on this phone and never leave it</string>
    <string name="onboarding_point_sealed">Every message is sealed end to end before it moves</string>
    <string name="onboarding_point_relays">Each chat crosses six Tor relays, none of which sees both ends</string>
    <string name="onboarding_name_hint">What should friends call you?</string>
    <string name="onboarding_sigil_hint">A glyph for your node, 1–2 characters (optional)</string>
    <string name="onboarding_create">Create my node</string>
    <string name="onboarding_restore">Restore from a backup</string>
    <string name="onboarding_footnote">The first start takes 30 seconds or more while Tor connects. Later starts take a few seconds.</string>
    <string name="onboarding_name_required">Pick a name your friends will recognise</string>

