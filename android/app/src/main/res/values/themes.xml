<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- One dark theme. A chat app whose whole point is that nobody is
         watching should not light up a dark room. -->
    <style name="Theme.TorChat" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/tc_primary</item>
        <item name="colorOnPrimary">@color/tc_on_primary</item>
        <item name="colorPrimaryContainer">@color/tc_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/tc_on_primary_container</item>
        <item name="colorSecondary">@color/tc_signal</item>
        <item name="colorOnSecondary">@color/tc_on_signal</item>
        <item name="colorSecondaryContainer">@color/tc_signal_dim</item>
        <item name="colorOnSecondaryContainer">@color/tc_text</item>
        <item name="colorTertiary">@color/tc_warning</item>
        <item name="colorError">@color/tc_error</item>
        <item name="colorOnError">@color/tc_on_error</item>

        <item name="android:colorBackground">@color/tc_bg</item>
        <item name="colorSurface">@color/tc_bg</item>
        <item name="colorOnSurface">@color/tc_text</item>
        <item name="colorOnSurfaceVariant">@color/tc_text_dim</item>
        <item name="colorSurfaceContainerLowest">@color/tc_bg</item>
        <item name="colorSurfaceContainerLow">@color/tc_surface</item>
        <item name="colorSurfaceContainer">@color/tc_surface</item>
        <item name="colorSurfaceContainerHigh">@color/tc_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/tc_surface_highest</item>
        <item name="colorOutline">@color/tc_outline</item>
        <item name="colorOutlineVariant">@color/tc_outline_soft</item>

        <item name="android:windowBackground">@color/tc_bg</item>
        <item name="android:statusBarColor">@color/tc_bg</item>
        <item name="android:navigationBarColor">@color/tc_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="toolbarStyle">@style/Widget.TorChat.Toolbar</item>
        <item name="materialCardViewStyle">@style/Widget.TorChat.Card</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Widget.TorChat.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">@color/tc_bg</item>
        <item name="titleTextColor">@color/tc_text</item>
        <item name="subtitleTextColor">@color/tc_text_dim</item>
    </style>

    <style name="Widget.TorChat.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/tc_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/tc_outline_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Shown over another app when someone shares a contact code with us. -->
    <style name="Theme.TorChat.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorPrimary">@color/tc_primary</item>
        <item name="colorOnPrimary">@color/tc_on_primary</item>
        <item name="colorSecondary">@color/tc_signal</item>
        <item name="colorSurface">@color/tc_surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>

    <style name="TextAppearance.TorChat.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/tc_text_dim</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.TorChat.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/tc_text_faint</item>
    </style>

    <style name="TextAppearance.TorChat.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
